#   cp .env.example .env

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_hub
DB_USER=pheme
DB_PASSWORD=change_me

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# docker run --rm confluentinc/cp-kafka:7.9.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=your_cluster_id_here

# ─── Mail (Mailpit) ──────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
